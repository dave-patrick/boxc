<Window x:Class="BoxC.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About boxc" Width="380" SizeToContent="Height"
        Background="#18191c" Foreground="#e6e8ea"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        BorderBrush="#2d3139" BorderThickness="1">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ButtonStyles.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif"/>
                <Setter Property="Foreground" Value="#d0d4dc"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="24,18,24,20">

        <!-- Wordmark (includes tagline) -->
        <Image Source="/assets/wordmark.png" Width="332" HorizontalAlignment="Center" Margin="0,0,0,14"
               RenderOptions.BitmapScalingMode="HighQuality"/>

        <!-- Version -->
        <TextBlock Text="VERSION" FontWeight="SemiBold" FontSize="11" Foreground="#8a929b" Margin="0,0,0,6"/>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Release" Foreground="#8a929b" Margin="0,2"/>
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ReleaseText" Margin="0,2"/>
            <TextBlock Grid.Row="1" Text="Build" Foreground="#8a929b" Margin="0,2"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="BuildText" Margin="0,2"/>
        </Grid>

        <!-- Credits -->
        <TextBlock Text="CREDITS" FontWeight="SemiBold" FontSize="11" Foreground="#8a929b" Margin="0,0,0,6"/>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Developed by" Foreground="#8a929b" Margin="0,2" VerticalAlignment="Center"/>
            <Image Grid.Row="0" Grid.Column="1" Source="/assets/atomic22-industries.png" Width="200" HorizontalAlignment="Left"
                   Margin="0,4,0,10" ToolTip="Atomic 22 Industries" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Grid.Row="1" Text="Graphics by" Foreground="#8a929b" Margin="0,2"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="Atomic 22 Design" FontWeight="SemiBold" Foreground="#3b8ec4" Margin="0,2"/>
        </Grid>

        <Button Content="Close" Width="92" Height="34" HorizontalAlignment="Right"
                IsDefault="True" IsCancel="True" Style="{StaticResource PrimaryButton}"/>
    </StackPanel>
</Window>
