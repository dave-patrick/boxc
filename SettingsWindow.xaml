<Window x:Class="BoxC.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="boxc Settings" Height="360" Width="360"
        Background="#18191c" Foreground="#e6e8ea"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        BorderBrush="#2d3139" BorderThickness="1" ShowInTaskbar="True">

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ButtonStyles.xaml"/></ResourceDictionary.MergedDictionaries>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif"/>
            <Setter Property="Foreground" Value="#d0d4dc"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#e6e8ea"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#e6e8ea"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Hotkey Section -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="GLOBAL SHORTCUT" FontWeight="SemiBold" FontSize="11" Foreground="#8a929b" Margin="0,0,0,6"/>
            <TextBox x:Name="HotkeyBox" Text="Ctrl + Shift + X"
                     Background="#22252a" Foreground="#3b8ec4" FontWeight="SemiBold"
                     BorderBrush="#3a3f47" BorderThickness="1"
                     Padding="10,7" FontSize="13" Focusable="True" IsReadOnly="True" Cursor="Hand"
                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" ToolTip="Click, then press a new combination (needs Ctrl, Shift or Alt)"/>
        </StackPanel>

        <!-- Selection Tool Section -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="DEFAULT SELECTION" FontWeight="SemiBold" FontSize="11" Foreground="#8a929b" Margin="0,0,0,6"/>
            <RadioButton x:Name="BoxRadio" Content="Rectangle (Click &amp; drag)" IsChecked="True"/>
            <RadioButton x:Name="LassoRadio" Content="Freehand Lasso"/>
            <CheckBox x:Name="ShiftCheck" Content="Hold Shift to toggle mode" IsChecked="True" Foreground="#8a929b" FontSize="12" Margin="18,2,0,0"/>
        </StackPanel>

        <!-- Text Cleanup Section -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="OCR POST-PROCESSING" FontWeight="SemiBold" FontSize="11" Foreground="#8a929b" Margin="0,0,0,6"/>
            <CheckBox x:Name="JoinCheck" Content="Join wrapped lines into paragraphs"/>
            <CheckBox x:Name="IconsCheck" Content="Strip UI icons and symbols from tabular data" IsChecked="True"/>
        </StackPanel>

        <!-- Bottom Actions -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="84" Height="34" Margin="0,0,8,0" IsCancel="True" Style="{StaticResource GhostButton}"/>
            <Button Content="Save" Width="84" Height="34" IsDefault="True" Click="Save_Click" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
